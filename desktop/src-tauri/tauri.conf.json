{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Parishkar",
  "version": "0.1.0",
  "identifier": "org.parishkar.desktop",
  "build": {
    "frontendDist": "../offline"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "appimage", "deb"],
    "category": "Utility",
    "shortDescription": "Report civic problems and follow them to a fix",
    "longDescription": "Parishkar: the civic report map, case files, leaders and public records for India, in a desktop window.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
