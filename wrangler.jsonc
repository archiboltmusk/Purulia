// Cloudflare Workers Builds serves the static site from the repo root.
// What gets left out lives in .assetsignore (mirrors github-pages.yml).
// worker.js only handles /r/<id> (link previews for shared reports); everything else is the static files.
{
  "name": "purulia",
  "compatibility_date": "2026-09-01",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/r/*"]
  },
  // Required by `wrangler preview` (the per-branch preview builds).
  "previews": {}
}
